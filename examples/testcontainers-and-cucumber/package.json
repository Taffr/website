{
  "name": "ts-express-mongo-redis-cucumber-typed",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "cucumber-js --require-module ts-node/register 'features/**/*.feature' --require 'features/**/*.ts'"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "mongodb": "^5.9.0",
    "redis": "^5.10.0",
    "testcontainers": "^9.1.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^9.0.0",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.7",
    "@types/node": "^20.5.0",
    "chai": "^4.3.8",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.6"
  }
